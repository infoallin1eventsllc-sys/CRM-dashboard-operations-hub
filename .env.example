# GEMINI_API_KEY: Required for Gemini AI API calls.
# Held by the Express server only; never shipped to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: injected by the hosting platform (Render, Cloud Run). Defaults to 3000.
# PORT=3000

# --- Build-time flags (Vite bakes these into the bundle) ---

# VITE_DEMO_MODE: set to "true" to build the click-through demonstration that
# the marketing site hosts. No sign-in, data in localStorage, AI answered
# locally. Leave unset for the real product. See src/demo.ts.
# VITE_DEMO_MODE=true

# DEMO_BASE: the path the demonstration is served from, e.g. /demos/meridian-crm/
# DEMO_BASE=/demos/meridian-crm/
